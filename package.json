{
  "name": "eslint-plugin-zustand-architecture",
  "version": "0.1.0",
  "description": "ESLint plugin that understands Zustand architecture rather than generic JS dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["eslint", "eslint-plugin", "zustand", "architecture", "state-management"],
  "contributors": [
    {
      "name": "harish S Khot",
      "email": "khot.harish1207@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khotharish1207/eslint-plugin-zustand-architecture.git"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.8.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}